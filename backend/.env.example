# DATABASE_URL for local development (default PostgreSQL credentials)
# If your postgres password is different, update this line
DATABASE_URL=postgresql://postgres:root@localhost:5432/ims_db

# JWT secret key
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_GENERATED_STRONG_SECRET_KEY

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=480

# Audit/Logging retention configuration
AUDIT_LOG_RETENTION_DAYS=365
LOG_FILE=backend/logs/app.log
LOG_RETENTION_DAYS=180

# Bootstrap admin credentials (used during initial database seeding)
# Set these before first setup so shop admin gets known login details.
# If omitted, setup may generate secure random credentials in backend/.env.
IMS_ADMIN_EMAIL=admin@yourcompany.com
IMS_ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# Email configuration (optional for development)
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=noreply@yourcompany.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Frontend URL — the exact origin users open in the browser (scheme://host[:port]).
# This is the primary CORS origin. On a server deployment set it to your real URL,
# e.g. http://139.59.62.156:8080
FRONTEND_URL=http://localhost:3001

# Deployment environment: development | staging | production
# NOTE: "production" enables HTTPSRedirectMiddleware — only use it when TLS is terminated
# (directly or via reverse proxy sending X-Forwarded-Proto: https). Do NOT set production
# while serving plain HTTP, or every request will 307-redirect to https and break.
ENVIRONMENT=development

# OPTIONAL: extra allowed CORS origins (comma-separated). Only needed if the API is served
# from a DIFFERENT origin than FRONTEND_URL. This is read from the real process environment
# (export / systemd Environment=), NOT from this .env file. Leave unset to just use FRONTEND_URL.
# FRONTEND_ALLOWED_ORIGINS=http://139.59.62.156:8080,http://another-host

# Auth cookie flags.
# COOKIE_SECURE=true  -> cookies only stored/sent over HTTPS (REQUIRED for real production w/ TLS).
# COOKIE_SECURE=false -> needed when serving over plain HTTP (e.g. bare server IP without a cert),
#                        otherwise the browser silently drops the auth cookies and every request 401s.
# COOKIE_SAMESITE=lax is the safe default for same-origin app+API; use 'none' (with secure=true)
# only if the API is on a different site than the frontend.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Company name
COMPANY_NAME=Your Company Name
