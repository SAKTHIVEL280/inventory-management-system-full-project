# DATABASE_URL for local development (default PostgreSQL credentials)
# If your postgres password is different, update this line
DATABASE_URL=postgresql://postgres:root@localhost:5432/ims_db

# JWT secret key (change this in production)
SECRET_KEY=dev-secret-change-this-in-production

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email configuration (optional for development)
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=noreply@yourcompany.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Company name
COMPANY_NAME=Your Company Name
